# PIP host service configuration (copy to .env; never commit .env)

# Cloud planner (optional). Leave empty to use the offline LocalRulePlanner.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2-0905-preview

# Host service
PIP_HOST_PORT=18421
PIP_DB_PATH=data/pip.db
PIP_TIMEZONE=America/Toronto

# Device transport: auto | usb | sim | none
PIP_TRANSPORT=auto
# Explicit serial port (otherwise auto-detected by VID 0x303A / PID 0x1001)
PIP_SERIAL_PORT=
# Simulator address used when PIP_TRANSPORT=sim
PIP_SIM_ADDR=127.0.0.1:18422

# Safety gate: tools/flash_board.py refuses to flash unless this is 1
PIP_ALLOW_AUTO_FLASH=0

# Speech
PIP_STT_MODEL=small.en
PIP_PIPER_BIN=
PIP_PIPER_VOICE=
