# PIP firmware - ESP-IDF v5.5.5, Waveshare ESP32-S3-RLCD-4.2 (ESP32-S3-WROOM-1-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# keep internal RAM for DMA/Wi-Fi: anything over 4 KB that can live in PSRAM goes there
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# D2: USB Serial/JTAG carries ONLY the binary protocol. Logs go to UART0 (GPIO43/44).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Radios: Wi-Fi link to the PC (ADR-019); Bluetooth stays off
CONFIG_BT_ENABLED=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# In-app firmware updates: two OTA slots, new firmware must prove itself or it rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# On-device wake word (ESP-SR WakeNet9), models in the "model" partition
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_SR_WN_WN9_HIJOY_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Away link over TLS (ADR-035): mbedtls buffers (16 KB TLS records, handshake) live in PSRAM - internal RAM is
# tight with Wi-Fi + WakeNet. CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC (the default) would put ~30 KB there.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
